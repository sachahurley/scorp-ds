{
  "name": "scorp-ds",
  "private": true,
  "version": "0.0.1",
  "description": "Scorp Design System — TUI-inspired React/TypeScript component library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api-surface": "node scripts/generate-api-surface.mjs",
    "api-surface:check": "node scripts/generate-api-surface.mjs --check",
    "audit:glyphs": "node scripts/audit-glyphs.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:components": "npm run build --workspace=packages/components",
    "build:site": "npm run build --workspace=@scorp-ds/site",
    "build:tokens": "npm run build --workspace=packages/tokens",
    "dev": "npm run --workspace=packages/storybook storybook",
    "ds-health": "bash scripts/ds-health.sh",
    "generate-specs": "node scripts/generate-draft-specs.mjs",
    "lint": "eslint packages/*/src packages/site/src packages/storybook/stories packages/storybook/presets packages/storybook/.storybook",
    "preview": "node scripts/preview.mjs",
    "preview:fresh": "node scripts/preview.mjs --fresh",
    "site": "npm run dev --workspace=@scorp-ds/site",
    "spec-drift": "bash scripts/detect-spec-drift.sh",
    "storybook": "npm run --workspace=packages/storybook storybook",
    "storybook:clean": "rm -rf node_modules/.cache/storybook node_modules/.vite node_modules/.cache/vite packages/storybook/node_modules/.vite",
    "test": "vitest run --config vitest.config.mts",
    "test-storybook": "npm run test-storybook --workspace=@scorp-ds/storybook",
    "test-storybook:ci": "npm run build-storybook --workspace=@scorp-ds/storybook && node scripts/test-storybook-ci.mjs",
    "tui-art": "tsx packages/tui-art/src/cli.ts",
    "type-check": "npm run type-check --workspaces --if-present",
    "visual": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.0.0"
  }
}
