{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scorp-ds/docs/contracts/schema.json",
  "title": "Scorp DS API surface",
  "description": "Machine-readable public API of every component and primitive. Generated by scripts/generate-api-surface.mjs. Prose (intent, anatomy, token maps) lives in docs/specs/ and is deliberately not duplicated here.",
  "type": "object",
  "required": [
    "exports",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "generatedBy": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/component"
      }
    },
    "exports": {
      "type": "array",
      "description": "Everything @scorp-ds/components exports from its barrel, including what lives outside components/ and primitives/ (ThemeProvider, cn, hooks), with the file it comes from.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "from"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "component",
              "function",
              "const",
              "interface",
              "type"
            ]
          },
          "from": {
            "type": "string",
            "description": "Repo-relative source file."
          }
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": [
        "layer",
        "file",
        "spec",
        "import",
        "exports",
        "props",
        "apiHash"
      ],
      "additionalProperties": false,
      "properties": {
        "layer": {
          "enum": [
            "component",
            "primitive"
          ]
        },
        "file": {
          "type": "string",
          "description": "Repo-relative source path."
        },
        "spec": {
          "type": "string",
          "description": "Repo-relative spec path."
        },
        "import": {
          "type": "string",
          "description": "Package to import from."
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "component",
                  "function",
                  "const",
                  "interface",
                  "type"
                ],
                "description": "`component` is a PascalCase export that can be rendered; `function` and `const` are everything else."
              }
            }
          }
        },
        "props": {
          "type": "object",
          "description": "Keyed by the exported interface or type alias name. Prop sets list their own props and the React DOM attribute interfaces they inherit; literal-union aliases list their members.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "props"
                ],
                "additionalProperties": false,
                "properties": {
                  "props": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/prop"
                    }
                  },
                  "inherits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "React DOM attribute interfaces whose props are also accepted, e.g. ButtonHTMLAttributes."
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "union"
                ],
                "additionalProperties": false,
                "properties": {
                  "union": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        },
        "apiHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "sha256 (truncated) of the structural API only: exported names and kinds, prop names, types, accepted values, optionality, defaults, deprecations and inherited attribute sets. Descriptions are excluded, so improving a JSDoc line does not read as an API change."
        }
      }
    },
    "prop": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every value the prop accepts, with aliases expanded through the type checker, when the type is a union of literals."
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "The prop's JSDoc text."
        },
        "deprecatedValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The subset of `values` that comes from an alias tagged @deprecated. Still accepted; do not use in new code."
        },
        "deprecated": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "Present when the prop itself is tagged @deprecated; the tag's message, or true."
        }
      }
    }
  }
}
