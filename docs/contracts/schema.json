{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scorp-ds/docs/contracts/schema.json",
  "title": "Scorp DS API surface",
  "description": "Machine-readable public API of every component and primitive. Generated by scripts/generate-api-surface.mjs. Prose (intent, anatomy, token maps) lives in docs/specs/ and is deliberately not duplicated here.",
  "type": "object",
  "required": ["components"],
  "properties": {
    "$schema": { "type": "string" },
    "generatedBy": { "type": "string" },
    "note": { "type": "string" },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["layer", "file", "spec", "import", "exports", "props", "apiHash"],
      "additionalProperties": false,
      "properties": {
        "layer": { "enum": ["component", "primitive"] },
        "file": { "type": "string", "description": "Repo-relative source path." },
        "spec": { "type": "string", "description": "Repo-relative spec path." },
        "import": { "type": "string", "description": "Package to import from." },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "kind": { "enum": ["function", "const", "interface", "type"] }
            }
          }
        },
        "props": {
          "type": "object",
          "description": "Keyed by the exported interface or type alias name.",
          "additionalProperties": {
            "oneOf": [
              { "type": "array", "items": { "$ref": "#/definitions/prop" } },
              {
                "type": "object",
                "required": ["union"],
                "additionalProperties": false,
                "properties": { "union": { "type": "array", "items": { "type": "string" } } }
              }
            ]
          }
        },
        "apiHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "sha256 (truncated) of the structural API only: exported names and kinds, prop names, types, optionality, union members and defaults. Descriptions are excluded, so improving a JSDoc line does not read as an API change."
        }
      }
    },
    "prop": {
      "type": "object",
      "required": ["name", "type", "required"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Union members, when the prop is a union."
        },
        "default": { "type": "string" },
        "description": { "type": "string", "description": "First JSDoc line." }
      }
    }
  }
}
